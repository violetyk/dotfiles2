<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.violetyk.herdr-sleep-guard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/herdr-sleep-guard</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>30</integer>
	<key>StandardErrorPath</key>
	<string>/var/log/herdr-sleep-guard.log</string>
</dict>
</plist>
