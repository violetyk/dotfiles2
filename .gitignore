.gitconfig.local

Brewfile.lock.json
package-lock.json

# ------------------------------------------------------------
# .config
# ~/.config はこのリポジトリの .config へのシンボリックリンクで、
# 各アプリが設定やキャッシュを勝手に書き込む。
# そのため原則すべて無視し、管理したいものだけを明示的に許可する。
# 追加するときは下の許可リストに 1 行足す。
# ------------------------------------------------------------
.config/*

# --- バージョン管理する対象 ---
!.config/fish/
!.config/ghostty/
!.config/git/
!.config/herdr/
!.config/zed/
!.config/pycodestyle
!.config/starship.toml

# --- 許可したディレクトリの中で除外するもの ---
# herdr（config.toml 以外はログ・ソケット・セッション状態などの生成物）
.config/herdr/*
!.config/herdr/config.toml
# fish（起動時に自動生成される変数）
.config/fish/fish_variables
# rust（rustup が生成）
.config/fish/conf.d/rustup.fish
# zed
.config/zed/prompts/

# vim
.vim/bundle
.vim/plugged
.vim/autoload/plug.vim

# ipython
.ipython/profile_default/db
.ipython/profile_default/log
.ipython/profile_default/pid
.ipython/profile_default/security
.ipython/profile_default/history.sqlite

!.gitkeep
